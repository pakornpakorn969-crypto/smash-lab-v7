# Application Settings
FLASK_APP=app.py
FLASK_ENV=production
SECRET_KEY=generate-a-strong-secret-key-here

# Database Configuration
DATABASE_URL=sqlite:///data/smashlab.db

# Admin Initial Credentials
ADMIN_EMAIL=admin@smashlab.com
